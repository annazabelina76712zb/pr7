<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movies"
        Height="650" Width="1000"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтр -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="150" Margin="0,0,8,0"
                     materialDesign:HintAssist.Hint="Жанр"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding FilterGenre, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="120" Margin="0,0,8,0"
                     materialDesign:HintAssist.Hint="Мин. год"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding FilterYear, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Фильтр" Click="BtnFilter_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="Обновить" Click="BtnRefresh_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>

        <!-- Список + форма -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Movies}"
                      SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                      SelectionChanged="Grid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="120"/>
                    <DataGridTextColumn Header="Мин." Binding="{Binding DurationMinutes}" Width="60"/>
                    <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding IsAvailable}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1">
                <TextBox materialDesign:HintAssist.Hint="Название"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>
                <TextBox materialDesign:HintAssist.Hint="Жанр"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>
                <TextBox materialDesign:HintAssist.Hint="Длительность"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding EditDuration, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>
                <TextBox materialDesign:HintAssist.Hint="Год"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding EditYear, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>
                <CheckBox Content="Доступен"
                          IsChecked="{Binding EditIsAvailable}"
                          Margin="0,0,0,10"/>

                <Button Content="Создать (POST)"    Click="BtnCreate_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"   Margin="0,0,0,6"/>
                <Button Content="Изменить (PUT)"    Click="BtnUpdate_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"   Margin="0,0,0,6"/>
                <Button Content="Частично (PATCH)"  Click="BtnPatch_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,6"/>
                <Button Content="Удалить (DELETE)"  Click="BtnDelete_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Red"/>
            </StackPanel>
        </Grid>

        <!-- Статус -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>